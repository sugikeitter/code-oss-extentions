{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["`", "`"],
    ["_", "_"],
    ["*", "*"],
    ["{", "}"],
    ["'", "'"],
    ["\"", "\""],
    ["~", "~"]
  ],
  "onEnterRules": [
    { "beforeText": "^\\s*-\\s+\\[[ xX]\\]\\s+\\S.*$", "action": { "indent": "none", "appendText": "- [ ] " } },
    { "beforeText": "^\\s*\\*\\s+\\[[ xX]\\]\\s+\\S.*$", "action": { "indent": "none", "appendText": "* [ ] " } },
    { "beforeText": "^\\s*\\+\\s+\\[[ xX]\\]\\s+\\S.*$", "action": { "indent": "none", "appendText": "+ [ ] " } },
    { "beforeText": "^\\s*-\\s+\\S.*$", "action": { "indent": "none", "appendText": "- " } },
    { "beforeText": "^\\s*\\*\\s+\\S.*$", "action": { "indent": "none", "appendText": "* " } },
    { "beforeText": "^\\s*\\+\\s+\\S.*$", "action": { "indent": "none", "appendText": "+ " } },
    { "beforeText": "^>\\s+\\S.*$", "action": { "indent": "none", "appendText": "> " } }
  ]
}
